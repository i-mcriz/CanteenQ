# ============================================================
# Supabase Cloud Database (PostgreSQL)
# ============================================================
# Obtain these from: Supabase Dashboard → Project Settings → Database → Connection String
#
# 1. Transaction Pooler (via PgBouncer/Supavisor, Port 6543) - Used by Prisma Client for queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (Port 5432) - Used by Prisma CLI for migrations / db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# NestJS Backend Authentication & Server
# ============================================================
PORT=4000
JWT_SECRET="canteenq-super-secret-jwt-key-32chars"
JWT_REFRESH_SECRET="canteenq-super-refresh-jwt-key-32chars"

# Allowed Frontend URL for CORS (in addition to localhost & *.vercel.app)
# FRONTEND_URL="https://canteenq.vercel.app"

# ============================================================
# Payment Gateway (Optional - Test Mode default)
# ============================================================
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
