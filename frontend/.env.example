# ============================================================
# CanteenQ Frontend Environment Variables
# ============================================================
# Connect to your NestJS Backend API / WebSocket server
# For local development:
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# For production deployment (e.g. on Render / Vercel):
NEXT_PUBLIC_API_URL="https://canteenq-backend.onrender.com"
NEXT_PUBLIC_GRAPHQL_URL="https://canteenq-backend.onrender.com/graphql"
NEXT_PUBLIC_WS_URL="https://canteenq-backend.onrender.com"
